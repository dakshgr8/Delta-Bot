# ==============================================================================
# Delta Exchange Algorithmic Trading Bot - Environment Configuration
# ==============================================================================

# Delta Exchange API Credentials
# Obtain these from your Delta Exchange account settings -> API Keys
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Supported Base URLs:
# - India:   https://api.india.delta.exchange
# - Global:  https://api.delta.exchange
# - Testnet: https://testnet-api.delta.exchange
DELTA_BASE_URL=https://api.delta.exchange

# Supported WebSocket URLs:
# - India:   wss://socket.india.delta.exchange
# - Global:  wss://socket.delta.exchange
DELTA_WS_URL=wss://socket.delta.exchange

# HTTP Client & Resilience Configuration
REQUEST_TIMEOUT_SEC=10.0
MAX_RETRIES=3
BACKOFF_BASE_SEC=0.5
BACKOFF_MAX_SEC=8.0

# WebSocket Engine Configuration
WS_HEARTBEAT_INTERVAL_SEC=20.0
WS_RECONNECT_MAX_ATTEMPTS=0
BAR_CACHE_CAPACITY=500

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Orchestrator & Deployment Configuration
EXECUTION_MODE=paper
FLATTEN_ON_SHUTDOWN=false
TARGET_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT
TIMEFRAME=1m
DEFAULT_LEVERAGE=5
DEFAULT_RISK_PCT=1.0
STATUS_INTERVAL_SEC=60.0

# Web Dashboard & Control API Authentication (Optional, leave blank for open localhost access)
DASHBOARD_AUTH_TOKEN=change_me_to_a_secure_token_in_production

# Supabase Multi-Tenant Authentication & PostgreSQL Persistence
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_KEY=your_supabase_anon_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your_project_id.supabase.co:5432/postgres
