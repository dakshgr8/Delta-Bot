# ==============================================================================
# Delta-Bot Developer Platform Environment Configuration (.env.example)
# ==============================================================================
# NOTE: User Delta Exchange API keys and secrets are NOT stored in this file.
# Each user enters and manages their own API credentials securely in Supabase
# via the Delta-Bot Trader Portal UI (Account Settings).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Daemon & Strategy Core Configuration (Real / LIVE Trading Engine)
# ------------------------------------------------------------------------------
EXECUTION_MODE=live
FLATTEN_ON_SHUTDOWN=false
TARGET_SYMBOLS=BTCUSD,ETHUSD,SOLUSD,XRPUSD,XAUTUSD
TIMEFRAME=1m
DEFAULT_LEVERAGE=5
DEFAULT_RISK_PCT=1.0
STATUS_INTERVAL_SEC=60.0

# ------------------------------------------------------------------------------
# 2. HTTP Client & WebSocket Resilience Engine (Delta Exchange India)
# ------------------------------------------------------------------------------
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange
REQUEST_TIMEOUT_SEC=10.0
MAX_RETRIES=3
BACKOFF_BASE_SEC=0.5
BACKOFF_MAX_SEC=8.0
WS_HEARTBEAT_INTERVAL_SEC=20.0
WS_RECONNECT_MAX_ATTEMPTS=0
BAR_CACHE_CAPACITY=500
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Developer Master Dashboard Token & Web Gateway
# ------------------------------------------------------------------------------
DASHBOARD_AUTH_TOKEN=change_me_to_a_secure_token_in_production
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 4. Supabase Developer Platform Credentials (Delta-Bot)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your_project_id.supabase.co
SUPABASE_KEY=your_supabase_anon_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your_project_id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 5. Cloud Deployments
# ------------------------------------------------------------------------------
RENDER_BACKEND_URL=https://your-backend-app.onrender.com
VERCEL_FRONTEND_URL=https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# 6. Cron-Job.org Keep-Alive
# ------------------------------------------------------------------------------
CRON_JOB_ORG_API_KEY=your_cron_job_org_api_key
CRON_JOB_ID=your_cron_job_id
